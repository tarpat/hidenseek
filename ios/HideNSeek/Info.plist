<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Hide n Seek</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.tarunpatanjali.hidenseek</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hidenseek</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Hide n Seek uses the camera to take photos and videos to share in the game chat.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Hide n Seek connects to a game server on your local network during development.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Hide n Seek keeps sharing your position with your game while your phone is locked, only during an active game.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Hide n Seek shows your position to players in your game while a game is running.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Hide n Seek records sound with videos you share in the game chat.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Hide n Seek can save the photos and videos shared in a game to your Photos library when the game ends.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
